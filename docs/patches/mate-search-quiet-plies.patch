+// The mate search alone, on the seat's board (or 'board A|B'), for the side
+// to move there, or after one move of that side ('after e2e4').
+void hbmate(std::istringstream& is) {
+  uint64_t nodes = 20000;
+  int plies = 40, board = -1;
+  std::string token, afterMove;
+  while (is >> token)
+      if      (token == "nodes") is >> nodes;
+      else if (token == "plies") is >> plies;
+      else if (token == "after") is >> afterMove;
+      else if (token == "board") { is >> token; board = token == "B" || token == "b" ? BOARD_B : BOARD_A; }
+
+  actual();
+  spawn([nodes, plies, board, afterMove]() {
+      TeamState& ts = actual();
+      const int b = board < 0 ? seat_context().board : board;
+      const Position& pos = ts.pos(b);
+      Mate::new_go();
+      Mate::Result r;
+      std::string mv = afterMove;
+      if (mv.empty())
+          r = Mate::search(ts.fen(b), nodes, plies);
+      else
+          r = Mate::after(ts.fen(b), UCI::to_move(pos, mv), nodes, plies);
+      sync_cout << "hbmate {\"mate\":" << (r.mate ? "true" : "false")
+                << ",\"refuted\":" << (r.refuted ? "true" : "false")
+                << ",\"first\":\"" << (r.mate ? UCI::move(pos, r.first) : std::string()) << "\""
+                << ",\"nodes\":" << r.nodes << "}" << sync_endl;
+  });
+}
