diff --git a/engine/src/hb_mate.cpp b/engine/src/hb_mate.cpp
new file mode 100644
index 0000000..b0e2e7e
--- /dev/null
+++ b/engine/src/hb_mate.cpp
@@ -0,0 +1,231 @@
+/*
+  HypeBeast, a bughouse team engine built on Fairy-Stockfish
+  Copyright (C) 2026 HypeBeast authors
+
+  This program is free software: you can redistribute it and/or modify
+  it under the terms of the GNU General Public License as published by
+  the Free Software Foundation, either version 3 of the License, or
+  (at your option) any later version.
+*/
+
+#include <algorithm>
+#include <deque>
+#include <memory>
+#include <vector>
+
+#include "hb_mate.h"
+#include "hb_team_state.h"
+#include "movegen.h"
+#include "position.h"
+#include "thread.h"
+
+namespace Stockfish::HB::Mate {
+
+namespace {
+
+// Proof and disproof numbers of "the attacker mates from here". 0 / Inf is a
+// proof, Inf / 0 a disproof. A proof holds wherever the position occurs. A
+// disproof may come from the ply limit or from a repetition on the line, so
+// it only ever costs a mate that is there, never claims one that is not.
+constexpr uint32_t Inf = 1u << 28;
+
+struct Entry {
+  Key key = 0;
+  uint32_t pn = 1, dn = 1;
+  uint32_t gen = 0;
+};
+
+constexpr size_t TableBits = 19;          // 512k entries, 12 MB
+std::vector<Entry> Table;
+uint32_t Gen = 1;
+
+// The same position is one entry when White attacks and another when Black does.
+constexpr Key SaltOf[COLOR_NB] = { 0x9E3779B97F4A7C15ULL, 0xC2B2AE3D27D4EB4FULL };
+
+struct Search {
+  uint64_t nodes = 0, maxNodes = 0;
+  int maxPly = 0;
+  Key salt = 0;
+  Move rootMove = MOVE_NONE;
+  std::vector<Key> path;
+};
+
+inline Entry& slot(Key k) { return Table[size_t(k) & ((size_t(1) << TableBits) - 1)]; }
+
+inline bool lookup(Key k, uint32_t& pn, uint32_t& dn) {
+  const Entry& e = slot(k);
+  if (e.gen == Gen && e.key == k)
+  {
+      pn = e.pn, dn = e.dn;
+      return true;
+  }
+  pn = dn = 1;
+  return false;
+}
+
+inline void store(Key k, uint32_t pn, uint32_t dn) {
+  Entry& e = slot(k);
+  e.key = k, e.pn = std::min(pn, Inf), e.dn = std::min(dn, Inf), e.gen = Gen;
+}
+
+struct Child {
+  Move move;
+  Key key;
+};
+
+// The moves searched at a node: the attacker's checks, or every reply.
+void moves_of(const Position& pos, bool attacker, std::vector<Child>& out) {
+  for (const auto& m : MoveList<LEGAL>(pos))
+      if (!attacker || pos.gives_check(m))
+          out.push_back(Child{m, 0});
+}
+
+// A position seen for the first time: mate and "no check left" are settled at
+// once, and otherwise the number of moves steers the search (few replies are
+// easy to prove, few checks easy to refute).
+void first_look(const Position& pos, bool attacker, uint32_t& pn, uint32_t& dn) {
+  int n = 0;
+  for (const auto& m : MoveList<LEGAL>(pos))
+      n += !attacker || pos.gives_check(m);
+  if (attacker)
+      pn = n ? 1 : Inf, dn = n ? uint32_t(n) : 0;
+  else if (n)
+      pn = uint32_t(n), dn = 1;
+  else
+      pn = pos.checkers() ? 0 : Inf, dn = pos.checkers() ? Inf : 0;   // mate, or no move without check
+}
+
+void mid(Position& pos, Search& s, uint32_t thpn, uint32_t thdn, bool attacker, int ply) {
+  const Key key = pos.key() ^ s.salt;
+  std::vector<Child> ch;
+  moves_of(pos, attacker, ch);
+  if (ch.empty())
+  {
+      uint32_t pn, dn;
+      first_look(pos, attacker, pn, dn);
+      store(key, pn, dn);
+      return;
+  }
+  if (ply >= s.maxPly)
+  {
+      store(key, Inf, 0);
+      return;
+  }
+
+  StateInfo st;
+  for (Child& c : ch)
+  {
+      pos.do_move(c.move, st);
+      ++s.nodes;
+      c.key = pos.key() ^ s.salt;
+      uint32_t pn, dn;
+      if (!lookup(c.key, pn, dn))
+      {
+          first_look(pos, !attacker, pn, dn);
+          store(c.key, pn, dn);
+      }
+      pos.undo_move(c.move);
+  }
+
+  s.path.push_back(key);
+  while (true)
+  {
+      // The attacker needs one move that mates (least proof number) and the
+      // defender one that escapes (least disproof number); the other number
+      // is the sum over all moves.
+      uint64_t sum = 0;
+      uint32_t best = Inf + 1, second = Inf + 1, bestOther = 0;
+      int bi = -1;
+      for (int i = 0; i < int(ch.size()); ++i)
+      {
+          uint32_t pn, dn;
+          if (std::find(s.path.begin(), s.path.end(), ch[i].key) != s.path.end())
+              pn = Inf, dn = 0;                    // a repetition is no mate
+          else
+              lookup(ch[i].key, pn, dn);
+          const uint32_t sel = attacker ? pn : dn, add = attacker ? dn : pn;
+          sum += add;
+          if (sel < best)
+              second = best, best = sel, bi = i, bestOther = add;
+          else if (sel < second)
+              second = sel;
+      }
+      const uint32_t total = uint32_t(std::min<uint64_t>(sum, Inf));
+      const uint32_t pn = attacker ? std::min(best, Inf) : total;
+      const uint32_t dn = attacker ? total : std::min(best, Inf);
+      if (pn >= thpn || dn >= thdn || s.nodes >= s.maxNodes)
+      {
+          store(key, pn, dn);
+          if (ply == 0 && attacker && pn == 0 && bi >= 0)
+              s.rootMove = ch[bi].move;
+          break;
+      }
+      // Search the chosen move until it stops being the best one, or this
+      // node's own bounds are reached.
+      const uint64_t next = std::min<uint64_t>(uint64_t(second) + 1, Inf);
+      uint32_t cpn, cdn;
+      if (attacker)
+      {
+          cpn = uint32_t(std::min<uint64_t>(thpn, next));
+          cdn = uint32_t(std::min<uint64_t>(uint64_t(thdn) - dn + bestOther, Inf));
+      }
+      else
+      {
+          cdn = uint32_t(std::min<uint64_t>(thdn, next));
+          cpn = uint32_t(std::min<uint64_t>(uint64_t(thpn) - pn + bestOther, Inf));
+      }
+      pos.do_move(ch[bi].move, st);
+      ++s.nodes;
+      mid(pos, s, cpn, cdn, !attacker, ply + 1);
+      pos.undo_move(ch[bi].move);
+  }
+  s.path.pop_back();
+}
+
+Result run(Position& pos, uint64_t maxNodes, int maxPly) {
+  if (Table.empty())
+      Table.resize(size_t(1) << TableBits);
+  Search s;
+  s.maxNodes = std::max<uint64_t>(maxNodes, 1);
+  s.maxPly = std::max(maxPly, 1);
+  s.salt = SaltOf[pos.side_to_move()];
+  mid(pos, s, Inf, Inf, true, 0);
+  Result r;
+  r.nodes = s.nodes;
+  uint32_t pn, dn;
+  if (lookup(pos.key() ^ s.salt, pn, dn))
+  {
+      r.mate = pn == 0 && s.rootMove != MOVE_NONE;
+      r.refuted = dn == 0;
+  }
+  r.first = r.mate ? s.rootMove : MOVE_NONE;
+  return r;
+}
+
+} // namespace
+
+void new_go() {
+  ++Gen;
+}
+
+Result search(const std::string& fen, uint64_t maxNodes, int maxPly) {
+  StateListPtr states(new std::deque<StateInfo>(1));
+  Position pos;
+  pos.set(bughouse_variant(), fen, false, &states->back(), Threads.main());
+  return run(pos, maxNodes, maxPly);
+}
+
+Result after(const std::string& fen, Move m, uint64_t maxNodes, int maxPly) {
+  StateListPtr states(new std::deque<StateInfo>(1));
+  Position pos;
+  pos.set(bughouse_variant(), fen, false, &states->back(), Threads.main());
+  if (!MoveList<LEGAL>(pos).contains(m))
+      return Result();
+  StateInfo st;
+  pos.do_move(m, st);
+  Result r = run(pos, maxNodes, maxPly);
+  pos.undo_move(m);
+  return r;
+}
+
+} // namespace Stockfish::HB::Mate
diff --git a/engine/src/hb_mate.h b/engine/src/hb_mate.h
new file mode 100644
index 0000000..0d1c8dd
--- /dev/null
+++ b/engine/src/hb_mate.h
@@ -0,0 +1,52 @@
+/*
+  HypeBeast, a bughouse team engine built on Fairy-Stockfish
+  Copyright (C) 2026 HypeBeast authors
+
+  This program is free software: you can redistribute it and/or modify
+  it under the terms of the GNU General Public License as published by
+  the Free Software Foundation, either version 3 of the License, or
+  (at your option) any later version.
+*/
+
+// Mate search (HBMateSearch). A proof-number search (df-pn) of one board in
+// which the attacker plays only moves that give check and the defender every
+// legal reply, with the pieces each side holds now. It follows forced lines
+// far deeper than the main search, at a small fixed cost.
+//
+// A result of mate=true is a proof on that board with the present pockets: a
+// piece that reaches the defender later may still break it. mate=false means
+// only that no proof was found within the limits.
+
+#ifndef HB_MATE_H_INCLUDED
+#define HB_MATE_H_INCLUDED
+
+#include <string>
+
+#include "types.h"
+
+namespace Stockfish {
+class Position;
+}
+
+namespace Stockfish::HB::Mate {
+
+struct Result {
+  bool mate = false;        // the side to move at the root mates by checks
+  bool refuted = false;     // searched out: no such mate within maxPly
+  Move first = MOVE_NONE;   // first move of the proof
+  uint64_t nodes = 0;       // moves made
+};
+
+/// Forget what earlier searches stored (start of a go).
+void new_go();
+
+/// Does the side to move in `fen` mate by checks? At most maxNodes moves are
+/// made and lines are cut after maxPly plies.
+Result search(const std::string& fen, uint64_t maxNodes, int maxPly);
+
+/// The same after `m` is played in `fen`: does the side that replies mate?
+Result after(const std::string& fen, Move m, uint64_t maxNodes, int maxPly);
+
+} // namespace Stockfish::HB::Mate
+
+#endif // #ifndef HB_MATE_H_INCLUDED
